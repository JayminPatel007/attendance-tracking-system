# Copy to .env and adjust for your local stack. docker-compose reads these.
# All have safe dev defaults baked into docker-compose.yml; override here for
# anything you don't want to ship as a default.

# --- Web BFF (ADR-0022) ---------------------------------------------------
# Confidential client secret for the sabha-web client. MUST match the "secret"
# of sabha-web in infra/keycloak/realm-sabha.json.
SABHA_WEB_CLIENT_SECRET=dev-web-secret

# --- Install-time Madhyastha Karyalaya bootstrap (ADR-0011) ----------------
# The first MK member is seeded once at backend startup (idempotent: skipped if
# any MK member already exists). The member is created in Keycloak with a forced
# first-login password change. Leave USERNAME/PASSWORD blank to skip seeding.
SABHA_BOOTSTRAP_MK_USERNAME=mk-admin
SABHA_BOOTSTRAP_MK_PASSWORD=changeme123!
SABHA_BOOTSTRAP_MK_FULL_NAME=Madhyastha Karyalaya Member
SABHA_BOOTSTRAP_MK_GENDER=MALE
SABHA_BOOTSTRAP_MK_MOBILE=+910000000900
