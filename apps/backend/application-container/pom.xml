<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.sabha</groupId>
        <artifactId>backend-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>application-container</artifactId>
    <name>Application Container</name>
    <description>
        The single Spring Boot deployable (ADR-0019). Wires all bounded-context
        adapter modules together via component scan, owns application.yml, runs
        Liquibase migrations at boot, houses the SecurityFilterChain, the global
        @RestControllerAdvice + ErrorResponse, the in-process DomainEventPublisher
        implementation, and the cross-context integration smoke tests. Only this
        module produces a fat jar.
    </description>

    <properties>
        <!-- OpenAPI drift gate (issue #73): override with -Dopenapi.regenerate=true. -->
        <openapi.regenerate>false</openapi.regenerate>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>common-domain</artifactId>
        </dependency>

        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>identity-data-access</artifactId>
        </dependency>
        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>identity-application</artifactId>
        </dependency>
        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>identity-messaging</artifactId>
        </dependency>

        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>sabha-data-access</artifactId>
        </dependency>
        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>sabha-application</artifactId>
        </dependency>
        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>sabha-messaging</artifactId>
        </dependency>

        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>attendance-data-access</artifactId>
        </dependency>
        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>attendance-application</artifactId>
        </dependency>
        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>attendance-messaging</artifactId>
        </dependency>

        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>analytics-data-access</artifactId>
        </dependency>
        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>analytics-application</artifactId>
        </dependency>
        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>analytics-messaging</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>

        <!--
            springdoc renders the live controllers as an OpenAPI document at
            /v3/api-docs (issue #73). The -api starter exposes only the JSON spec,
            not Swagger UI, keeping the production surface to the contract itself.
            That document is the source the typed web/mobile clients generate from.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <version>2.8.17</version>
        </dependency>

        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.github.dasniko</groupId>
            <artifactId>testcontainers-keycloak</artifactId>
            <version>3.7.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.4.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>backend</finalName>
        <testResources>
            <testResource>
                <directory>${project.basedir}/src/test/resources</directory>
            </testResource>
            <testResource>
                <directory>${project.basedir}/../../../infra/keycloak</directory>
                <includes>
                    <include>realm-sabha.json</include>
                </includes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!--
                            docker-java defaults to API 1.32, which Docker Desktop 24+ rejects.
                            Force a modern API version compatible with Docker 24+ servers.
                            Testcontainers reads this via System.getProperty("api.version").
                        -->
                        <api.version>1.43</api.version>
                        <!--
                            Passes the OpenAPI drift-gate's regenerate switch (issue #73)
                            into the forked test JVM. Defaults to false (drift fails the
                            build); run `mvn ... -Dopenapi.regenerate=true` after an
                            intentional contract change to rewrite the committed spec.
                        -->
                        <openapi.regenerate>${openapi.regenerate}</openapi.regenerate>
                    </systemPropertyVariables>
                    <environmentVariables>
                        <!--
                            Ryuk (Testcontainers' cleanup-reaper container) can't start on
                            macOS Docker Desktop — the socket bind-mount it needs is unsupported
                            (issue #72). Disabling it repo-side means a fresh clone runs green
                            with no per-developer env-var setup. Our containers are JVM-lifetime
                            singletons, so JVM shutdown reclaims them without Ryuk; ephemeral CI
                            runners discard everything anyway. Disabling Ryuk is env-var-only in
                            Testcontainers (no classpath-property equivalent), hence here.
                        -->
                        <TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
