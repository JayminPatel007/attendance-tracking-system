<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.sabha</groupId>
        <artifactId>backend-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>coverage-aggregate</artifactId>
    <packaging>pom</packaging>
    <name>Coverage Aggregate (JaCoCo)</name>
    <description>
        Reporting-only module. It depends on every other module so that
        jacoco:report-aggregate can collect their classes, sources and
        target/jacoco.exec data into one cross-module report. This matters here
        because most tests live in application-container but exercise code across
        all modules — per-module reports would massively undercount. Produces
        target/site/jacoco-aggregate/jacoco.xml, consumed by the new-code
        coverage gate in .github/workflows/backend.yml.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>common-domain</artifactId>
        </dependency>

        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>identity-domain-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>identity-application-service</artifactId>
        </dependency>
        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>identity-data-access</artifactId>
        </dependency>
        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>identity-messaging</artifactId>
        </dependency>
        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>identity-application</artifactId>
        </dependency>

        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>sabha-domain-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>sabha-application-service</artifactId>
        </dependency>
        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>sabha-data-access</artifactId>
        </dependency>
        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>sabha-messaging</artifactId>
        </dependency>
        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>sabha-application</artifactId>
        </dependency>

        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>attendance-domain-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>attendance-application-service</artifactId>
        </dependency>
        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>attendance-data-access</artifactId>
        </dependency>
        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>attendance-messaging</artifactId>
        </dependency>
        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>attendance-application</artifactId>
        </dependency>

        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>analytics-domain-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>analytics-application-service</artifactId>
        </dependency>
        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>analytics-data-access</artifactId>
        </dependency>
        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>analytics-messaging</artifactId>
        </dependency>
        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>analytics-application</artifactId>
        </dependency>

        <dependency>
            <groupId>org.sabha</groupId>
            <artifactId>application-container</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/site/jacoco-aggregate</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
