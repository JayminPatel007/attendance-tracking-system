<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>org.sabha</groupId>
    <artifactId>backend-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Sabha Attendance Backend (parent)</name>
    <description>
        Multi-module modular monolith. Per ADR-0019, each bounded context is split
        into five Maven modules (domain-core / application-service / data-access /
        messaging / application) under a *-service / *-domain aggregator. The
        common-domain module is shared across contexts; application-container is
        the single Spring Boot deployable.
    </description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <modules>
        <module>common-domain</module>

        <module>identity-domain</module>
        <module>identity-application</module>
        <module>identity-infrastructure</module>

        <module>sabha-domain</module>
        <module>sabha-application</module>
        <module>sabha-infrastructure</module>

        <module>attendance-service</module>

        <module>analytics-domain</module>
        <module>analytics-application</module>
        <module>analytics-infrastructure</module>

        <module>application-container</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>common-domain</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>identity-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>identity-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>identity-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>sabha-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>sabha-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>sabha-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>attendance-domain-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>attendance-application-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>attendance-data-access</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>attendance-messaging</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>attendance-application</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>analytics-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>analytics-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>analytics-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
