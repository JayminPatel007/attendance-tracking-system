<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>org.sabha</groupId>
    <artifactId>backend-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Sabha Attendance Backend (parent)</name>
    <description>
        Multi-module modular monolith. Per ADR-0019, each bounded context is split
        into five Maven modules (domain-core / application-service / data-access /
        messaging / application) under a *-service / *-domain aggregator. The
        common-domain module is shared across contexts; application-container is
        the single Spring Boot deployable.
    </description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
            Annotation-only artifact (no framework) used by the presentation ring to
            describe the wire contract for springdoc (issue #104). Keep in step with
            the swagger-core that springdoc-openapi pulls into application-container:
            `mvn -pl application-container dependency:tree -Dincludes=io.swagger.core.v3:*`.
        -->
        <swagger-annotations.version>2.2.47</swagger-annotations.version>
    </properties>

    <modules>
        <module>common-domain</module>

        <module>identity-service</module>
        <module>sabha-service</module>
        <module>attendance-service</module>
        <module>analytics-service</module>

        <module>application-container</module>

        <!-- Builds last: aggregates JaCoCo exec data from every module above into a
             single cross-module coverage report (see coverage-aggregate/pom.xml). -->
        <module>coverage-aggregate</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>common-domain</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>identity-domain-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>identity-application-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>identity-data-access</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>identity-messaging</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>identity-application</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>sabha-domain-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>sabha-application-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>sabha-data-access</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>sabha-messaging</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>sabha-application</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>attendance-domain-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>attendance-application-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>attendance-data-access</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>attendance-messaging</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>attendance-application</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>analytics-domain-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>analytics-application-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>analytics-data-access</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>analytics-messaging</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.sabha</groupId>
                <artifactId>analytics-application</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations-jakarta</artifactId>
                <version>${swagger-annotations.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Instruments every module's tests so each produces target/jacoco.exec.
                 The coverage-aggregate module merges these into one report. Plugin
                 version is managed by spring-boot-starter-parent. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
