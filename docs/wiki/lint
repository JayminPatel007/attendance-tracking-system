#!/usr/bin/env python3
"""Deterministic linter for docs/wiki. No LLM, no network, stdlib only.

The wiki is an **OKF v0.2 knowledge bundle** (docs/wiki/protocol.md). This script is
the bundle's conformance checker as well as its producer linter — per the OKF
reference-bundle research (#171) it is, as far as that survey could tell, the first
§11 checker in existence: the spec ships no schema, no validator and no CI job.

Implements the nine checks fixed in docs/wiki/protocol.md §9:

  1. every in-wiki markdown link resolves AND its text is the target's filename stem
  2. filename stems are unique across kind dirs, and index.md lists every page once
  3. frontmatter conformance: §11 clauses 1-2, the required fields, and `sources[]`
  4. every prose section carries a coverage tag with a valid level (compiled types)
  5. the checkpoint is a real commit, and `status` is `disputed` or `deprecated`
  6. every source_paths glob still matches at least one file  <- the orphan check
  7. skeleton conformance: fixed per-type sections, in order, empties written `_none_`
  8. prose word count is within the §2 budget  <- a WARNING, never affects the exit code
  9. every in-repo `sources[].resource` is watched by a `source_paths` glob

§11 conformance is spread across those numbers rather than spending one of its own
(protocol.md §9): clause 1 (parseable frontmatter) and clause 2 (`type` present and
non-empty) are check 3's first two assertions, and clause 3 (`index.md` follows §8)
is the index skeleton in check 7 plus the index frontmatter rule in check 3.

Linted files are index.md plus every page under the four type directories.
`protocol.md` and `log.md` are excluded: protocol.md documents the contract and so
quotes illustrative links and skeletons that are not real.

Usage:  docs/wiki/lint [repo-root]
Exit:   0 clean, 1 on any failure, 2 on a usage/setup error.
"""

from __future__ import annotations

import functools
import glob as globlib
import os
import re
import subprocess
import sys
from pathlib import Path

TYPE_DIRS = {
    "structure": "structure",
    "feature": "features",
    "pattern": "patterns",
    "note": "notes",
}
COMPILED_TYPES = ("structure", "feature", "pattern")

# The version of the OKF spec this bundle is written against. Declared once, at the
# bundle root, and nowhere else (protocol.md §3).
OKF_VERSION = "0.2"

SKELETONS = {
    "structure": [
        "Purpose",
        "Layout",
        "Exposes",
        "Talks To",
        "Data",
        "Gotchas",
        "Covered by",
        "Method",
    ],
    "feature": [
        "What it does",
        "Flow",
        "Rules & authority",
        "Where the code is",
        "Amendments",
        "Method",
    ],
    "pattern": [
        "The pattern",
        "Why",
        "Where it appears",
        "Deviations",
        "Method",
    ],
    # index.md's sections were already fixed and ordered; §11 clause 3 asks that the
    # bundle root follow §8, and this is what that assertion looks like here.
    "index": [
        "Start here",
        "Structure",
        "Features",
        "Patterns",
        "Notes",
    ],
}

# The catalog table under each of these index headings, and the type it lists.
CATALOG_SECTIONS = {
    "Structure": "structure",
    "Features": "feature",
    "Patterns": "pattern",
    "Notes": "note",
}

# `Method` is written for the *next compiler*, not for a reader answering a question:
# it states how the page was compiled, which is no more a derivation from evidence
# than evidence is (protocol.md §4). One constant, two exemptions — no coverage tag
# (check 4) and no place in the word budget (check 8, protocol.md §2), because that is
# the same reasoning `prose_words` already uses to exclude coverage tags and table rows.
COMPILER_ONLY_SECTIONS = {"Method"}

# The closed tag vocabulary (protocol.md §3). Closed because tags *partition*: an
# open vocabulary degrades silently into authz/auth/authorization. This check
# enforces *membership only*: §3's 3+ floor and <=-half ceiling are a protocol
# judgement made at re-measure time, not computed here, so a tag may sit over its
# ceiling — recorded in §3's table — on a clean run. Counts live in §3, not here.
TAGS = {"offline-sync", "audit", "bff"}

# Prose-word budgets (protocol.md §2), all three derived over the finished corpus
# with `prose_words` below. The sample sizes and observed ranges are §2's table;
# they are not repeated here, because a copy of a number nothing recomputes can
# only drift. What belongs here is why these three stay put: a band that widens
# to silence a check-8 warning is not an observation.
BUDGETS = {
    "structure": 550,
    "feature": 750,
    "pattern": 750,
}

CHECKPOINT_FIELD = {
    "structure": "last_compiled",
    "feature": "last_compiled",
    "pattern": "last_compiled",
    "note": "last_verified",
}

STORED_STATUSES = ("disputed", "deprecated")
STATUS_REASON = {"disputed": "disputed_reason", "deprecated": "deprecated_reason"}

HEADING = re.compile(r"^(#{1,6})\s+(.*?)\s*$")
COVERAGE = re.compile(r"^<!--\s*\[coverage:\s*(high|medium|low)(\s+--\s+\S.*?)?\s*\]\s*-->$")
MD_LINK = re.compile(r"\[([^\]]*)\]\(([^)\s]+)(?:\s+\"[^\"]*\")?\)")
SHA = re.compile(r"^[0-9a-f]{40}$")
ADR_SOURCE_ID = re.compile(r"^adr-(\d{4})$")
SLUG = re.compile(r"^[a-z0-9][a-z0-9-]*$")
URL_SCHEME = re.compile(r"^[a-z][a-z0-9+.-]*:")

SOURCE_KEYS = ("id", "title", "resource")


class Page:
    def __init__(self, path: Path, rel: str, meta: dict, body: list[str], body_offset: int,
                 is_index: bool = False):
        self.path = path
        self.is_index = is_index
        self.rel = rel
        self.meta = meta
        self.body = body            # list of lines, frontmatter stripped
        self.body_offset = body_offset  # 1-based line number of body[0] in the file

    def line_no(self, idx: int) -> int:
        return self.body_offset + idx

    @property
    def type(self) -> str:
        """`index` is a position in the bundle, not a frontmatter value.

        §11 clause 3 makes the bundle root the one file that carries no `type` (it may
        carry `okf_version` and nothing else), so index-ness is tracked here rather
        than injected into `meta`, where check 3 would then report it as an extra key.
        """
        return "index" if self.is_index else self.meta.get("type", "")

    @property
    def stem(self) -> str:
        return self.path.stem

    @property
    def deprecated(self) -> bool:
        return self.meta.get("status") == "deprecated"

    @property
    def scaffold(self) -> bool:
        """The build unit exists and is declared, but holds no types yet (protocol.md §3).

        Not a `status`: §6's two states are opposed on the recompile axis and are
        mutually exclusive for that reason, while a scaffold page recompiles like any
        other and may perfectly well also be `disputed`.
        """
        return self.meta.get("scaffold") == "true"


class Failures:
    def __init__(self) -> None:
        self.items: list[str] = []

    def add(self, check: int, rel: str, line: int | None, msg: str) -> None:
        where = f"{rel}:{line}" if line else rel
        self.items.append(f"{where}: [check {check}] {msg}")

    def __len__(self) -> int:
        return len(self.items)


class Warnings(Failures):
    """Same format, no exit code. Check 8 only — see protocol.md §9."""


# --------------------------------------------------------------------------- parsing


def split_outside_quotes(text: str, sep: str) -> list[str]:
    """Split on `sep`, ignoring separators inside double quotes.

    Needed because a source's `title` is a real sentence: four ADR titles in this
    repo contain a comma and two contain a colon.
    """
    out: list[str] = []
    buf: list[str] = []
    in_quotes = False
    for ch in text:
        if ch == '"':
            in_quotes = not in_quotes
            buf.append(ch)
        elif ch == sep and not in_quotes:
            out.append("".join(buf))
            buf = []
        else:
            buf.append(ch)
    out.append("".join(buf))
    return out


def strip_inline_comment(value: str) -> str:
    """Drop a trailing ` # comment`, but never a `#` inside quotes or a path."""
    in_quotes = False
    for i, ch in enumerate(value):
        if ch == '"':
            in_quotes = not in_quotes
        elif ch == "#" and not in_quotes and i > 0 and value[i - 1].isspace():
            return value[:i]
    return value


def unquote(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        return value[1:-1]
    return value


def parse_flow_mapping(text: str) -> dict:
    """`{ id: adr-0015, title: "…", resource: ../../adr/0015-….md }` -> dict."""
    text = text.strip()
    if text.startswith("{"):
        text = text[1:]
    if text.endswith("}"):
        text = text[:-1]
    entry: dict = {}
    for chunk in split_outside_quotes(text, ","):
        if not chunk.strip():
            continue
        key, sep, value = chunk.partition(":")
        if not sep:
            entry.setdefault("__malformed__", []).append(chunk.strip())
            continue
        entry[key.strip()] = unquote(value)
    return entry


def parse_frontmatter(lines: list[str]) -> tuple[dict, list[str], int, bool]:
    """Minimal YAML-subset reader.

    Handles `key: scalar`, `key: [a, b]` (the list optionally spread over several
    lines), and a block sequence of flow mappings for `sources:`. The wiki's
    frontmatter schema (protocol.md §3) is flat by construction apart from
    `sources[]`, so a real YAML parser would buy little and would drag in the
    dependency this script exists to avoid.

    The multi-line handling is deliberate and load-bearing twice over: `source_paths`
    carries a page's ADR globs alongside its code globs, and `sources[]` is one line
    per document. An earlier single-line-only parser silently dropped everything past
    the first entry — one of the two mechanism bugs #160 found.

    Returns (meta, body, body_offset, had_frontmatter).
    """
    if not lines or lines[0].strip() != "---":
        return {}, lines, 1, False

    meta: dict = {}
    i = 1
    while i < len(lines):
        if lines[i].strip() == "---":
            return meta, lines[i + 1:], i + 2, True
        raw = lines[i]
        i += 1
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        if ":" not in raw:
            continue
        key, _, value = raw.partition(":")
        key = key.strip()

        # A block sequence: `sources:` followed by `  - { … }` lines.
        if not value.strip():
            entries: list[dict] = []
            while i < len(lines) and lines[i].strip().startswith("- "):
                entries.append(parse_flow_mapping(lines[i].strip()[2:]))
                i += 1
            if entries:
                meta[key] = entries
                continue
            meta[key] = ""
            continue

        # A flow list may be spread over several lines; absorb until the bracket closes.
        if value.strip().startswith("[") and not value.strip().endswith("]"):
            while i < len(lines) and lines[i].strip() != "---":
                value += " " + lines[i].strip()
                i += 1
                if value.rstrip().endswith("]"):
                    break
        value = strip_inline_comment(value).strip()
        if value.startswith("[") and value.endswith("]"):
            inner = value[1:-1].strip()
            meta[key] = [unquote(v) for v in split_outside_quotes(inner, ",") if v.strip()]
        else:
            meta[key] = unquote(value)
    return meta, [], len(lines) + 1, True


def sections(page: Page) -> list[tuple[str, int, list[str]]]:
    """Top-level (`##`) sections as (title, body-index-of-heading, content-lines)."""
    out: list[tuple[str, int, list[str]]] = []
    current: tuple[str, int] | None = None
    buf: list[str] = []
    in_fence = False
    for idx, line in enumerate(page.body):
        if line.lstrip().startswith("```"):
            in_fence = not in_fence
        m = HEADING.match(line)
        if m and not in_fence and len(m.group(1)) == 2:
            if current:
                out.append((current[0], current[1], buf))
            current = (m.group(2).strip(), idx)
            buf = []
        elif current:
            buf.append(line)
    if current:
        out.append((current[0], current[1], buf))
    return out


def strip_comments(text: str) -> str:
    return re.sub(r"<!--.*?-->", "", text, flags=re.DOTALL)


def as_list(value) -> list:
    if isinstance(value, list):
        return value
    if isinstance(value, str) and value.strip():
        return [value.strip()]
    return []


# --------------------------------------------------------------------------- checks


def check_1_links(pages: list[Page], wiki: Path, stems: set[str], f: Failures) -> None:
    """The in-wiki namespace: the href resolves, and the text is the target's stem.

    Strictly stronger than the `[[slug]]` check it replaces (protocol.md §8): that
    one could only assert the slug named a page, this one asserts the path resolves
    *and* the text is right. A dangling link is now a 404 on GitHub rather than inert
    text, so tolerating one costs more than it used to.
    """
    for page in pages:
        in_fence = False
        for idx, line in enumerate(page.body):
            if line.lstrip().startswith("```"):
                in_fence = not in_fence
                continue
            if in_fence:
                continue
            for m in MD_LINK.finditer(line):
                text, href = m.group(1), m.group(2)
                target = href.split("#", 1)[0]
                if not target or URL_SCHEME.match(target):
                    continue
                resolved = (page.path.parent / target).resolve()
                try:
                    resolved.relative_to(wiki.resolve())
                except ValueError:
                    continue  # out of the wiki — check 3's namespace, not this one
                if resolved.suffix != ".md":
                    continue
                if not resolved.exists():
                    f.add(1, page.rel, page.line_no(idx),
                          f"in-wiki link `{target}` resolves to no page")
                elif text != resolved.stem:
                    f.add(1, page.rel, page.line_no(idx),
                          f"in-wiki link text `{text}` is not the target's filename stem "
                          f"`{resolved.stem}` (protocol.md §8)")
        # `bears_on` / `appears_in` take bare stems: frontmatter is machine-read and
        # never rendered, so the argument that won the body links has no purchase here.
        for key in ("bears_on", "appears_in"):
            for entry in as_list(page.meta.get(key)):
                if entry not in stems:
                    f.add(1, page.rel, None,
                          f"frontmatter {key}: `{entry}` resolves to no page")


def catalog_rows(index: Page) -> dict[str, list[tuple[int, list[str]]]]:
    """Per catalog section, the table rows as (line-index, cells)."""
    out: dict[str, list[tuple[int, list[str]]]] = {}
    for title, head_idx, content in sections(index):
        if title not in CATALOG_SECTIONS:
            continue
        rows: list[tuple[int, list[str]]] = []
        for offset, line in enumerate(content):
            stripped = line.strip()
            if not stripped.startswith("|"):
                continue
            cells = [c.strip() for c in stripped.strip("|").split("|")]
            if not cells or set("".join(cells)) <= set("-: "):
                continue  # the separator row
            if cells[0] == "Page":
                continue  # the header row
            rows.append((head_idx + 1 + offset, cells))
        out[title] = rows
    return out


def check_2_identity(pages: list[Page], index: Page | None, f: Failures) -> None:
    """Filename identity, plus the catalog as a pure function of the pages.

    #176 collapsed this check from three assertions to one when `slug` died — the
    filename became the single identity — which left it room for the catalog, whose
    load-bearing invariant is protocol.md §4's *every page exactly once*. Note the
    direction: check 1 asserts link -> page; this asserts **page -> link**, and it is
    the reverse edge that catches a page the sweep forgot to list.
    """
    seen: dict[str, str] = {}
    for page in pages:
        if page.type == "index":
            continue
        stem = page.stem
        if stem in seen:
            f.add(2, page.rel, None,
                  f"filename stem `{stem}` is already used by {seen[stem]} — stems are the "
                  "page identity and must be unique across type directories")
        else:
            seen[stem] = page.rel

    if index is None:
        return
    rows = catalog_rows(index)
    listed: dict[str, tuple[int, list[str]]] = {}
    for title, entries in rows.items():
        for line, cells in entries:
            m = MD_LINK.search(cells[0]) if cells else None
            if not m:
                f.add(2, index.rel, line, f"catalog row under `{title}` has no page link")
                continue
            stem = Path(m.group(2).split("#", 1)[0]).stem
            if stem in listed:
                f.add(2, index.rel, line, f"`{stem}` is listed in the catalog more than once")
                continue
            listed[stem] = (line, cells)

    for page in pages:
        if page.type == "index":
            continue
        if page.stem not in listed:
            f.add(2, index.rel, None,
                  f"`{page.stem}` is not listed in any catalog — protocol.md §4 requires "
                  "every page exactly once, which is what makes orphan detection possible")
            continue
        line, cells = listed.pop(page.stem)
        expected_middle = (page.meta.get("resource") if page.type == "structure"
                           else page.meta.get("description"))
        middle = cells[1] if len(cells) > 1 else ""
        middle_bare = middle.strip("`")
        if expected_middle and middle_bare != str(expected_middle):
            f.add(2, index.rel, line,
                  f"`{page.stem}` catalog cell 2 is {middle_bare!r}, but its frontmatter says "
                  f"{str(expected_middle)!r} — the catalog is a pure function of the pages")
        expected_aliases = ", ".join(as_list(page.meta.get("aliases")))
        actual_aliases = cells[2] if len(cells) > 2 else ""
        if actual_aliases != expected_aliases:
            f.add(2, index.rel, line,
                  f"`{page.stem}` catalog cell 3 is {actual_aliases!r}, but its frontmatter "
                  f"`aliases` say {expected_aliases!r}")
        for marker, held, where in (("(deprecated)", page.deprecated, "protocol.md §6"),
                                    ("(scaffold)", page.scaffold, "protocol.md §3")):
            marked = marker in cells[0]
            if held and not marked:
                f.add(2, index.rel, line,
                      f"`{page.stem}` carries the frontmatter for `{marker}` but its catalog "
                      f"row has no marker ({where})")
            elif marked and not held:
                f.add(2, index.rel, line,
                      f"`{page.stem}` is marked `{marker}` in the catalog but its frontmatter "
                      f"is not ({where})")

    for stem, (line, _) in listed.items():
        f.add(2, index.rel, line, f"catalog lists `{stem}`, which is not a page in this wiki")


def check_3_frontmatter(pages: list[Page], root: Path, wiki: Path, f: Failures) -> None:
    """Frontmatter conformance, and the out-of-wiki link namespace.

    Carries OKF §11 clauses 1 and 2 (parseable frontmatter; `type` present and
    non-empty) alongside this producer's own required fields. Skipped entirely on a
    `status: deprecated` page: every assertion here claims the subject still exists,
    which is exactly what a deprecation retracts (protocol.md §6).
    """
    adr_dir = root / "docs" / "adr"
    for page in pages:
        if page.type == "index":
            if set(page.meta) - {"okf_version"}:
                f.add(3, page.rel, None,
                      f"index frontmatter may carry nothing but `okf_version`; found "
                      f"{sorted(page.meta)} (OKF §8: only the bundle root declares it)")
            elif page.meta.get("okf_version") != OKF_VERSION:
                f.add(3, page.rel, None,
                      f"`okf_version: {page.meta.get('okf_version')!r}` — this bundle is "
                      f"written against OKF v{OKF_VERSION}")
            continue
        if page.deprecated:
            continue

        expected_dir = TYPE_DIRS.get(page.type)
        if expected_dir is None:
            f.add(3, page.rel, None,
                  f"frontmatter `type: {page.type or '(missing)'}` is not one of "
                  f"{sorted(TYPE_DIRS)} (OKF §11 clause 2)")
            continue
        if page.path.parent.name != expected_dir:
            f.add(3, page.rel, None, f"type `{page.type}` belongs in docs/wiki/{expected_dir}/")

        title = page.meta.get("title")
        if not isinstance(title, str) or not title.strip():
            f.add(3, page.rel, None, "missing frontmatter `title`")
        description = page.meta.get("description")
        if not isinstance(description, str) or not description.strip():
            f.add(3, page.rel, None, "missing frontmatter `description`")

        resource = page.meta.get("resource")
        if page.type == "structure":
            if not isinstance(resource, str) or not resource.strip():
                f.add(3, page.rel, None,
                      "missing frontmatter `resource` — a structure page names its build unit")
            elif not (root / resource).exists():
                f.add(3, page.rel, None, f"`resource: {resource}` does not exist on disk")
            elif not any(str(g).startswith(resource) for g in as_list(page.meta.get("source_paths"))):
                f.add(3, page.rel, None,
                      f"`resource: {resource}` is not a prefix of any source_paths glob — the "
                      "page would describe a unit it does not watch")
        elif resource:
            f.add(3, page.rel, None,
                  f"`resource` is a `structure` field only; `{page.type}` describes a capability "
                  "or an idea with no single asset to point at (OKF §4.1)")

        scaffold = page.meta.get("scaffold")
        if scaffold:  # a bare `scaffold:` reads as absence, exactly as check 5 reads `status:`
            if scaffold != "true":
                f.add(3, page.rel, None,
                      f"`scaffold: {scaffold!r}` — the only permitted value is `true`; absence "
                      "means the unit holds code, exactly as an absent `status` means current "
                      "(protocol.md §3)")
            elif page.type != "structure":
                f.add(3, page.rel, None,
                      f"`scaffold` is a `structure` field only; `{page.type}` describes a "
                      "capability or an idea, not a build unit that could be empty "
                      "(protocol.md §3)")

        for tag in as_list(page.meta.get("tags")):
            if tag not in TAGS:
                f.add(3, page.rel, None,
                      f"`tags: {tag}` is outside the closed vocabulary {sorted(TAGS)} "
                      "(protocol.md §3)")

        sources = page.meta.get("sources")
        entries = sources if isinstance(sources, list) else []
        if page.type in COMPILED_TYPES and not entries:
            f.add(3, page.rel, None,
                  "missing frontmatter `sources` (at least one entry required on a "
                  "compiled type)")
        seen_ids: set[str] = set()
        for entry in entries:
            if not isinstance(entry, dict) or entry.get("__malformed__"):
                f.add(3, page.rel, None, f"malformed `sources` entry: {entry!r}")
                continue
            extra = set(entry) - set(SOURCE_KEYS)
            if extra:
                f.add(3, page.rel, None,
                      f"`sources` entry carries {sorted(extra)}; the keys are {list(SOURCE_KEYS)}")
            source_id = entry.get("id", "")
            if not source_id or not SLUG.match(source_id):
                f.add(3, page.rel, None, f"`sources` entry id {source_id!r} is not a kebab slug")
            elif source_id in seen_ids:
                f.add(3, page.rel, None, f"`sources` id `{source_id}` is used twice on this page")
            else:
                seen_ids.add(source_id)
            if not entry.get("title"):
                f.add(3, page.rel, None, f"`sources` entry `{source_id}` has no `title`")
            target = entry.get("resource", "")
            if not target:
                f.add(3, page.rel, None, f"`sources` entry `{source_id}` has no `resource`")
                continue
            if URL_SCHEME.match(target):
                continue
            resolved = (page.path.parent / target).resolve()
            if not resolved.exists():
                f.add(3, page.rel, None,
                      f"`sources` resource `{target}` does not resolve on disk")
                continue
            adr = ADR_SOURCE_ID.match(source_id or "")
            if adr and not resolved.name.startswith(f"{adr.group(1)}-"):
                f.add(3, page.rel, None,
                      f"`sources` id `{source_id}` names ADR {adr.group(1)} but its resource is "
                      f"`{resolved.name}` — the stable id and the fragile path disagree")

        # Out-of-wiki links in the body live in `## Method` and nowhere else. Only
        # markdown links are path-checked: `## Method` also names globs and bare
        # filenames, which are not followable and must not be (protocol.md §4).
        for title_, head_idx, content in sections(page):
            if title_ != "Method":
                continue
            for offset, line in enumerate(content):
                for m in MD_LINK.finditer(line):
                    target = m.group(2).split("#", 1)[0]
                    if not target or URL_SCHEME.match(target):
                        continue
                    resolved = (page.path.parent / target).resolve()
                    try:
                        resolved.relative_to(wiki.resolve())
                        continue  # in-wiki: check 1 owns it
                    except ValueError:
                        pass
                    if not resolved.exists():
                        f.add(3, page.rel, page.line_no(head_idx + 1 + offset),
                              f"Method link `{target}` does not resolve on disk")


def check_4_coverage(pages: list[Page], f: Failures) -> None:
    for page in pages:
        if page.type not in COMPILED_TYPES:
            continue  # notes are primary evidence, not a derivation (protocol.md §5)
        for title, head_idx, content in sections(page):
            if title in COMPILER_ONLY_SECTIONS:
                continue
            tag_line = next((line for line in content if line.strip()), None)
            if tag_line is None or "[coverage:" not in tag_line:
                f.add(4, page.rel, page.line_no(head_idx),
                      f"section `{title}` has no coverage tag as its first non-empty line")
            elif not COVERAGE.match(tag_line.strip()):
                f.add(4, page.rel, page.line_no(head_idx + 1),
                      f"section `{title}` has a malformed coverage tag: {tag_line.strip()!r} "
                      "(want `<!-- [coverage: high|medium|low -- reason] -->`, "
                      "reason required on low/medium)")
            else:
                m = COVERAGE.match(tag_line.strip())
                if m.group(1) in ("low", "medium") and not m.group(2):
                    f.add(4, page.rel, page.line_no(head_idx + 1),
                          f"section `{title}` is tagged `{m.group(1)}` with no ` -- reason`")


def check_5_checkpoint(pages: list[Page], root: Path, git_ok: bool, f: Failures) -> None:
    """The checkpoint, and the two stored statuses.

    `disputed` and `deprecated` are mutually exclusive by construction — one key
    holding one of two directly opposed sweep instructions (protocol.md §6).
    """
    for page in pages:
        if page.type == "index":
            continue
        field = CHECKPOINT_FIELD.get(page.type)
        if field is None:
            continue
        status = page.meta.get("status")
        if status:
            if status not in STORED_STATUSES:
                f.add(5, page.rel, None,
                      f"`status: {status}` is not a stored status — the vocabulary is "
                      f"{list(STORED_STATUSES)} (draft/current/stale/orphaned are computed "
                      "or derived; protocol.md §6)")
            else:
                if status == "deprecated" and page.type == "note":
                    f.add(5, page.rel, None,
                          "`status: deprecated` is forbidden on a note — §7 already evicts a "
                          "note by deleting it, and the link cascade `deprecated` prevents does "
                          "not exist for notes")
                reason = STATUS_REASON[status]
                if not page.meta.get(reason):
                    f.add(5, page.rel, None, f"`status: {status}` without a `{reason}` line")
            for other, reason in STATUS_REASON.items():
                if other != status and page.meta.get(reason):
                    f.add(5, page.rel, None,
                          f"`{reason}` is set but `status` is `{status}`")
        else:
            for reason in STATUS_REASON.values():
                if page.meta.get(reason):
                    f.add(5, page.rel, None, f"`{reason}` is set but `status` is not")

        value = page.meta.get(field)
        if not isinstance(value, str) or not value:
            f.add(5, page.rel, None, f"missing frontmatter `{field}`")
            continue
        if not SHA.match(value):
            f.add(5, page.rel, None, f"`{field}: {value}` is not a full 40-character commit sha")
            continue
        if git_ok and not commit_exists(root, value):
            f.add(5, page.rel, None, f"`{field}: {value}` is not a commit in this repository")


@functools.lru_cache(maxsize=None)
def matching_files(pattern: str, root: Path, git_ok: bool) -> tuple[str, ...]:
    """What a `source_paths` glob actually matches, under **git's** pathspec rules.

    This is not a stylistic choice. Git's `**` matches one *or more* path components
    where Python's `glob` matches zero or more, so `common-domain/**/src/main/**`
    matches 42 files under Python and **nothing** under git — and git is the operative
    engine, since both the sweep and the reader run `git diff`. A linter using Python's
    semantics would let a glob lint clean and detect nothing, which is the second of
    the two mechanism bugs #160 found. Falls back to Python only when git is
    unavailable, where the degradation is announced.
    """
    if git_ok:
        result = subprocess.run(
            ["git", "ls-files", "-z", "--", pattern],
            cwd=root, capture_output=True, text=True,
        )
        if result.returncode == 0:
            return tuple(p for p in result.stdout.split("\0") if p)
        return ()
    return tuple(globlib.glob(pattern, root_dir=root, recursive=True))


def check_6_orphans(pages: list[Page], root: Path, git_ok: bool, f: Failures) -> None:
    for page in pages:
        if page.type == "index" or page.deprecated:
            continue  # a deprecation retracts the claim that the subject still exists
        patterns = page.meta.get("source_paths")
        if not isinstance(patterns, list) or not patterns:
            f.add(6, page.rel, None, "missing frontmatter `source_paths` (at least one glob required)")
            continue
        for pattern in patterns:
            if not matching_files(pattern, root, git_ok):
                f.add(6, page.rel, None,
                      f"source_paths glob `{pattern}` matches nothing under git — the subject may "
                      "have been deleted or moved, or the glob may be spelled for Python's `**` "
                      "rather than git's (orphan check; protocol.md §3)")


def check_7_skeleton(pages: list[Page], f: Failures) -> None:
    for page in pages:
        expected = SKELETONS.get(page.type)
        if expected is None:
            continue  # notes accrete facts, so they have no fixed section list
        found = sections(page)
        actual = [title for title, _, _ in found]
        if actual != expected:
            f.add(7, page.rel, None,
                  f"sections do not match the {page.type} skeleton\n"
                  f"        expected: {expected}\n"
                  f"        found:    {actual}")
            continue
        for title, head_idx, content in found:
            text = strip_comments("\n".join(content))
            text = "\n".join(
                line for line in text.splitlines()
                if not line.strip().startswith("[coverage:")
            ).strip()
            if not text:
                f.add(7, page.rel, page.line_no(head_idx),
                      f"section `{title}` is empty — write `_none_` rather than leaving it blank")


def prose_words(page: Page) -> int:
    """Words a reader actually reads: no frontmatter, no comments, no tables, no `Method`.

    The first three are ~45% of a structure page's `wc -w` (protocol.md §2) and none of
    them is what the budget is for — coverage tags are metadata about the page, and a
    table is scanned rather than read. `Method` is excluded on the same reasoning and
    on measurement (#179): it is addressed to the next compiler, and `web` read 543
    words excluding it both before and after the OKF migration, so the section was
    always the entire overage rather than growth the budgets had failed to anticipate.

    Everything before the first `##` — the H1 and any preamble — is counted, so this
    is a subtraction from the whole body rather than a sum over listed sections.
    """
    skipped: set[int] = set()
    for title, head_idx, content in sections(page):
        if title in COMPILER_ONLY_SECTIONS:
            skipped.update(range(head_idx, head_idx + len(content) + 1))
    kept = [line for idx, line in enumerate(page.body) if idx not in skipped]
    text = strip_comments("\n".join(kept))
    return sum(
        len(line.split())
        for line in text.splitlines()
        if not line.lstrip().startswith("|")
    )


def check_8_budget(pages: list[Page], w: Warnings) -> None:
    for page in pages:
        budget = BUDGETS.get(page.type)
        if budget is None:
            continue  # notes are primary evidence, not derivation — no skeleton, no budget
        count = prose_words(page)
        if count > budget:
            w.add(8, page.rel, None,
                  f"{count} prose words against a ~{budget} budget for `{page.type}` — "
                  "a smell, not a gate: check the admission test (protocol.md §2) before splitting")


def check_9_sources_watched(pages: list[Page], root: Path, git_ok: bool, f: Failures) -> None:
    """Every in-repo `sources[].resource` is watched by a `source_paths` glob (§3).

    This is what keeps `sources[]` from making a currency claim it cannot back. A page
    can otherwise list a document it was derived from that nothing watches, and look
    backed while being watched by nothing — verbatim the drift check 9 was written to
    prevent for the `decisions:` field it replaced, and the discharge of #160's
    binding condition on adopting `sources[]` at all.

    Generalising it closed protocol.md §3 rule 2 for free: *`CONTEXT.md` on every
    compiled page* was mandated by the contract and enforced by nothing.
    """
    for page in pages:
        if page.type not in COMPILED_TYPES or page.deprecated:
            continue  # a note's source_paths mean "what could falsify this"
        sources = page.meta.get("sources")
        if not isinstance(sources, list):
            continue  # check 3 already reports the missing field
        patterns = page.meta.get("source_paths")
        if not isinstance(patterns, list):
            continue  # check 6 already reports the missing field
        watched = {
            match
            for pattern in patterns
            for match in matching_files(pattern, root, git_ok)
        }
        for entry in sources:
            if not isinstance(entry, dict):
                continue
            target = entry.get("resource", "")
            if not target or URL_SCHEME.match(target):
                continue  # an external URL has no source_paths analogue
            resolved = (page.path.parent / target).resolve()
            if not resolved.exists():
                continue  # check 3 already reports it
            try:
                rel = os.path.relpath(resolved, root)
            except ValueError:
                continue
            if rel.startswith(".."):
                continue  # outside the repo entirely
            if rel not in watched:
                f.add(9, page.rel, None,
                      f"`sources` resource `{target}` is not watched by any source_paths glob — "
                      "add a glob for it, or the document can change without dirtying this page "
                      "(protocol.md §3)")


# --------------------------------------------------------------------------- driver


def commit_exists(root: Path, sha: str) -> bool:
    result = subprocess.run(
        ["git", "cat-file", "-e", f"{sha}^{{commit}}"],
        cwd=root, capture_output=True,
    )
    return result.returncode == 0


def git_available(root: Path) -> bool:
    result = subprocess.run(
        ["git", "rev-parse", "--git-dir"], cwd=root, capture_output=True,
    )
    return result.returncode == 0


def collect(wiki: Path, root: Path, f: Failures) -> list[Page]:
    paths: list[Path] = []
    index = wiki / "index.md"
    if index.exists():
        paths.append(index)
    for directory in sorted(set(TYPE_DIRS.values())):
        paths.extend(sorted((wiki / directory).glob("*.md")))

    pages: list[Page] = []
    for path in paths:
        rel = os.path.relpath(path, root)
        lines = path.read_text(encoding="utf-8").splitlines()
        meta, body, offset, had = parse_frontmatter(lines)
        is_index = path.name == "index.md"
        if not had:
            # OKF §11 clause 1: every non-reserved .md file carries parseable frontmatter.
            f.add(3, rel, None, "no frontmatter block (OKF §11 clause 1)")
            continue
        pages.append(Page(path, rel, meta, body, offset, is_index))
    return pages


def main(argv: list[str]) -> int:
    root = Path(argv[1]).resolve() if len(argv) > 1 else Path(__file__).resolve().parents[2]
    wiki = root / "docs" / "wiki"
    if not wiki.is_dir():
        print(f"wiki lint: no wiki at {wiki}", file=sys.stderr)
        return 2

    f = Failures()
    pages = collect(wiki, root, f)
    index = next((p for p in pages if p.type == "index"), None)
    stems = {p.stem for p in pages if p.type != "index"}
    git_ok = git_available(root)

    check_1_links(pages, wiki, stems, f)
    check_2_identity(pages, index, f)
    check_3_frontmatter(pages, root, wiki, f)
    check_4_coverage(pages, f)
    check_5_checkpoint(pages, root, git_ok, f)
    check_6_orphans(pages, root, git_ok, f)
    check_7_skeleton(pages, f)
    check_9_sources_watched(pages, root, git_ok, f)

    w = Warnings()
    check_8_budget(pages, w)

    if not git_ok:
        print("wiki lint: git unavailable — check 5 degraded to a format check, and checks 6 "
              "and 9 to Python glob semantics", file=sys.stderr)

    for item in w.items:
        print(item)
    if w:
        print(f"wiki lint: {len(w)} warning(s) — advisory, not a gate\n")

    if f:
        for item in f.items:
            print(item)
        print(f"\nwiki lint: {len(f)} failure(s) across {len(pages)} page(s)")
        return 1

    print(f"wiki lint: clean — {len(pages)} page(s)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
